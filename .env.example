
# Safe defaults: all integrations start in mock mode
OKTA_MODE=mock
GOOGLE_MODE=mock

# Okta (only needed for real API mode)
OKTA_DOMAIN=https://your-org.okta.com
OKTA_API_TOKEN=
OKTA_GROUP_ID=
OKTA_GROUP_NAME=engineering

# Google Workspace (only needed for real API mode)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_ADMIN_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=

# Mocked integrations
ONEPASSWORD_GROUP=engineering
MDM_PLATFORM=jamf

# Optional Slack incoming webhook
SLACK_WEBHOOK_URL=
